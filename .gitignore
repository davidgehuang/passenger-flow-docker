# ---- Environment / secrets（绝对禁止上传） ----
.env
.env.*
!.env.example
!.env.docker.example

# ---- Dependencies ----
node_modules/
.npm-cache/
*.local.yaml
public/vendor/
.local-mysql/
.maintenance
reports/
.env.local
artifacts/

.git.backup-*/


# ---- Logs ----
logs/
*.log
