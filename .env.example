# 仅用于单实例手工运行。TKE 使用 ConfigMap + Secret 注入，不向镜像复制此文件。
NODE_ENV=production
CONTAINER_RUNTIME=true
BIND_HOST=0.0.0.0
PORT=3030
APP_ENV_NAME=TENCENT
DB_HOST=REPLACE_PRIVATE_DB_HOST
DB_PORT=3306
DB_NAME=passenger_flow_codex
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_CONNECTION_LIMIT=5
DB_TIME_ZONE=+08:00
# 实验私网可暂时使用 false；供应商 CA 配齐后建议开启 true。
DB_SSL=false
DB_SSL_CA=
AUTO_INIT_SCHEMA=false
MAINTENANCE_MODE=false
DB_READ_ONLY=false
ENABLE_CONTINUOUS_WORKLOAD=false
APP_AUTH_USER=REPLACE_APP_LOGIN
APP_AUTH_PASSWORD=REPLACE_STRONG_APP_PASSWORD
