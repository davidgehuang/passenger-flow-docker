# 参考字段，不要直接复制示例密码启动。首次请运行启动入口的配置引导。
# DB_HOST=db 和 DB_PORT=3306 由 compose.yaml 设置，无需填写容器 IP。
DB_NAME=passenger_flow_codex
DB_USER=passenger_app
DB_PASSWORD=replace-with-your-own-db-password
MYSQL_ROOT_PASSWORD=replace-with-your-own-root-password
APP_AUTH_USER=local-admin
APP_AUTH_PASSWORD=replace-with-your-own-web-password
APP_HTTP_PORT=3030
