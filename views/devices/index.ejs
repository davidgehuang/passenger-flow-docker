<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <%- include('../partials/maintenanceBanner') %>

  <div class="container-fluid py-4">
    <h4 class="mb-3"><i class="bi bi-camera-video"></i> 客流设备管理 <span class="badge text-bg-secondary">共 <%= Number(total).toLocaleString('en-US') %> 台</span></h4>

    <a href="/base-data" class="btn btn-outline-primary mb-3">批量初始化／扩容</a>
    <a href="/devices/new" class="btn btn-primary mb-3">新增设备</a>
    <div class="card">
      <div class="card-body">
        <form class="row g-2" method="get" action="/devices">
          <div class="col-md-4">
            <input type="text" class="form-control" name="keyword" value="<%= keyword %>" placeholder="搜索：编码 / 名称 / IP">
          </div>
          <div class="col-md-3">
            <select class="form-select" name="status">
              <option value="">全部状态</option>
              <% ['ONLINE', 'OFFLINE', 'WARNING', 'MAINTENANCE'].forEach(s => { %>
                <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> 搜索</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mt-3">
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th><th>设备编码</th><th>设备名称</th><th>类型</th><th>所属门店</th>
              <th>IP 地址</th><th>固件</th><th>最后在线</th><th>状态</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% devices.forEach(d => { %>
              <tr>
                <td><%= d.device_id %></td>
                <td><code><%= d.device_code %></code></td>
                <td><a href="/devices/<%= d.device_id %>"><%= d.device_name %></a></td>
                <td><%= d.device_type %></td>
                <td><%= d.store_name || d.store_id %></td>
                <td><%= d.ip_address %></td>
                <td><%= d.firmware_version %></td>
                <td class="text-muted small"><%= d.last_online_time || '-' %></td>
                <td>
                  <% const cls = d.status === 'ONLINE' ? 'text-bg-success' : (d.status === 'OFFLINE' ? 'text-bg-danger' : (d.status === 'WARNING' ? 'text-bg-warning' : 'text-bg-secondary')); %>
                  <span class="badge <%= cls %>"><%= d.status %></span>
                </td>
                <td><a class="btn btn-sm btn-outline-secondary" href="/devices/<%= d.device_id %>/edit"><i class="bi bi-pencil"></i></a></td>
              </tr>
            <% }) %>
            <% if (!devices.length) { %>
              <tr><td colspan="10" class="text-center text-muted py-4">暂无数据</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
    <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= page - 1 %>&keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>">上一页</a></li>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <li class="page-item <%= p === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= p %>&keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>"><%= p %></a></li>
      <% } %>
      <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= page + 1 %>&keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>">下一页</a></li>
    </ul></nav>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
