<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <%- include('../partials/maintenanceBanner') %>

  <div class="container py-4" style="max-width: 860px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0"><i class="bi bi-camera-video"></i> <%= device.device_name %>
        <% const cls = device.status === 'ONLINE' ? 'text-bg-success' : (device.status === 'OFFLINE' ? 'text-bg-danger' : (device.status === 'WARNING' ? 'text-bg-warning' : 'text-bg-secondary')); %>
        <span class="badge <%= cls %>"><%= device.status %></span>
      </h4>
      <a class="btn btn-sm btn-outline-primary" href="/devices/<%= device.device_id %>/edit"><i class="bi bi-pencil"></i> 编辑</a>
    </div>

    <div class="card"><div class="card-body">
      <table class="table table-borderless mb-0" style="max-width: 560px;">
        <tr><th class="text-muted w-25">设备编码</th><td><code><%= device.device_code %></code></td></tr>
        <tr><th class="text-muted">设备名称</th><td><%= device.device_name %></td></tr>
        <tr><th class="text-muted">设备类型</th><td><%= device.device_type %></td></tr>
        <tr><th class="text-muted">所属门店</th><td><%= device.store_name || device.store_id %>（<%= device.city || '-' %>）</td></tr>
        <tr><th class="text-muted">IP 地址</th><td><%= device.ip_address %></td></tr>
        <tr><th class="text-muted">固件版本</th><td><%= device.firmware_version %></td></tr>
        <tr><th class="text-muted">安装日期</th><td><%= device.install_date || '-' %></td></tr>
        <tr><th class="text-muted">最后在线</th><td><%= device.last_online_time || '-' %></td></tr>
        <tr><th class="text-muted">创建时间</th><td><%= device.created_at %></td></tr>
      </table>
    </div></div>

    <a href="/devices" class="btn btn-outline-secondary mt-3">返回列表</a>
    <form method="post" action="/devices/<%= device.device_id %>/delete" class="mt-3" onsubmit="return confirm('仅能删除没有历史记录的设备，确认删除？')"><button class="btn btn-outline-danger">删除设备</button></form>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
