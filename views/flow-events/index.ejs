<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <%- include('../partials/maintenanceBanner') %>

  <div class="container-fluid py-4">
    <h4 class="mb-3"><i class="bi bi-activity"></i> 客流事件 <span class="badge text-bg-secondary">共 <%= Number(total).toLocaleString('en-US') %> 条</span></h4>

    <div class="card">
      <div class="card-body">
        <form class="row g-2" method="get" action="/flow-events">
          <div class="col-md-3">
            <select class="form-select" name="storeId">
              <option value="">全部门店</option>
              <% stores.forEach(s => { %>
                <option value="<%= s.store_id %>" <%= filters.storeId === String(s.store_id) ? 'selected' : '' %>><%= s.store_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <select class="form-select" name="direction">
              <option value="">全部方向</option>
              <option value="IN" <%= filters.direction === 'IN' ? 'selected' : '' %>>IN</option>
              <option value="OUT" <%= filters.direction === 'OUT' ? 'selected' : '' %>>OUT</option>
            </select>
          </div>
          <div class="col-md-2">
            <input type="date" class="form-control" name="dateFrom" value="<%= filters.dateFrom %>" title="开始日期">
          </div>
          <div class="col-md-2">
            <input type="date" class="form-control" name="dateTo" value="<%= filters.dateTo %>" title="结束日期">
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> 筛选</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mt-3">
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th><th>事件时间</th><th>门店</th><th>设备编码</th><th>方向</th>
              <th>人数</th><th>置信度</th><th>传感器</th><th>Trace ID</th>
            </tr>
          </thead>
          <tbody>
            <% events.forEach(e => { %>
              <tr>
                <td><%= e.id %></td>
                <td class="text-muted small"><%= e.event_time %></td>
                <td><%= e.store_name || e.store_id %></td>
                <td><code><%= e.device_code || e.device_id %></code></td>
                <td>
                  <% if (e.direction === 'IN') { %><span class="badge text-bg-success">IN</span><% } else { %><span class="badge text-bg-danger">OUT</span><% } %>
                </td>
                <td><%= e.people_count %></td>
                <td><%= e.confidence %></td>
                <td><%= e.sensor_type %></td>
                <td class="text-muted small"><code><%= String(e.trace_id).slice(0, 13) %>...</code></td>
              </tr>
            <% }) %>
            <% if (!events.length) { %>
              <tr><td colspan="9" class="text-center text-muted py-4">暂无数据</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
    <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= page - 1 %>&storeId=<%= filters.storeId %>&direction=<%= filters.direction %>&dateFrom=<%= filters.dateFrom %>&dateTo=<%= filters.dateTo %>">上一页</a></li>
      <li class="page-item disabled"><span class="page-link"><%= page %> / <%= totalPages %></span></li>
      <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= page + 1 %>&storeId=<%= filters.storeId %>&direction=<%= filters.direction %>&dateFrom=<%= filters.dateFrom %>&dateTo=<%= filters.dateTo %>">下一页</a></li>
    </ul></nav>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
