<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <%- include('../partials/maintenanceBanner') %>

  <div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0"><i class="bi bi-shop"></i> 门店管理 <span class="badge text-bg-secondary">共 <%= Number(total).toLocaleString('en-US') %> 家</span></h4>
      <a href="/base-data" class="btn btn-outline-primary mb-3">批量初始化／扩容</a>
    <a href="/stores/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> 新增门店</a>
    </div>

    <div class="card">
      <div class="card-body">
        <form class="row g-2" method="get" action="/stores">
          <div class="col-md-4">
            <input type="text" class="form-control" name="keyword" value="<%= keyword %>" placeholder="搜索：编码 / 名称 / 城市">
          </div>
          <div class="col-md-3">
            <select class="form-select" name="status">
              <option value="">全部状态</option>
              <% ['ACTIVE', 'MAINTENANCE', 'CLOSED'].forEach(s => { %>
                <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> 搜索</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card mt-3">
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th><th>编码</th><th>门店名称</th><th>区域</th><th>城市</th>
              <th>业态</th><th>开业日期</th><th>状态</th><th>更新时间</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% stores.forEach(s => { %>
              <tr>
                <td><%= s.store_id %></td>
                <td><code><%= s.store_code %></code></td>
                <td><a href="/stores/<%= s.store_id %>"><%= s.store_name %></a></td>
                <td><%= s.region %></td>
                <td><%= s.city %></td>
                <td><%= s.business_type %></td>
                <td><%= s.opening_date || '-' %></td>
                <td>
                  <% const stCls = s.status === 'ACTIVE' ? 'text-bg-success' : (s.status === 'MAINTENANCE' ? 'text-bg-warning' : 'text-bg-secondary'); %>
                  <span class="badge <%= stCls %>"><%= s.status %></span>
                </td>
                <td class="text-muted small"><%= s.updated_at %></td>
                <td><a class="btn btn-sm btn-outline-secondary" href="/stores/<%= s.store_id %>/edit"><i class="bi bi-pencil"></i></a></td>
              </tr>
            <% }) %>
            <% if (!stores.length) { %>
              <tr><td colspan="10" class="text-center text-muted py-4">暂无数据</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
    <nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">
      <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= page - 1 %>&keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>">上一页</a></li>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <li class="page-item <%= p === page ? 'active' : '' %>"><a class="page-link" href="?page=<%= p %>&keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>"><%= p %></a></li>
      <% } %>
      <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>"><a class="page-link" href="?page=<%= page + 1 %>&keyword=<%= encodeURIComponent(keyword) %>&status=<%= encodeURIComponent(status) %>">下一页</a></li>
    </ul></nav>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
